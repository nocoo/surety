{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@surety/db": ["../../packages/db/src/index.ts"],
      "@surety/db/*": ["../../packages/db/src/*"],
      "@surety/api": ["../../packages/api/src/index.ts"],
      "@surety/api/*": ["../../packages/api/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e/dev/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e-ui/types/**/*.ts",
    ".next-e2e-ui/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
