{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"types": ["bun", "node"],
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"],
			"@surety/api": ["../../packages/api/src/index.ts"],
			"@surety/api/*": ["../../packages/api/src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "local/**/*.ts"],
	"exclude": ["node_modules"]
}
