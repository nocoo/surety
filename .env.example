# Demo and E2E require no credentials. Start with bun run dev.
# Only explicit interactive Prod selection uses this server-side bearer token.
# Never use a VITE_ prefix for credentials.
# SURETY_DEV_API_TOKEN=

# CLI real-service endpoints; independent from local runtime selection.
# SURETY_LOGIN_URL=https://surety.hexly.ai
# SURETY_API_URL=https://surety-api.hexly.ai

# Remote administration only; not needed by local launchers or tests.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=
