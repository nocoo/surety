# ===========================================
# Surety - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Google OAuth Configuration
# -------------------------------------------
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# 1. Create a new OAuth 2.0 Client ID
# 2. Set Authorized JavaScript origins to your domain(s)
# 3. Set Authorized redirect URIs to:
#    - http://localhost:7015/api/auth/callback/google (development)
#    - https://yourdomain.com/api/auth/callback/google (production)

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# -------------------------------------------
# NextAuth Configuration
# -------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret-here

# Base URL for your application (used for callbacks)
# Leave empty to auto-detect from request headers
# Only set this if auto-detection doesn't work for your setup
# Examples:
#   - http://localhost:7015 (local development)
#   - https://surety.example.com (production)
NEXTAUTH_URL=

# -------------------------------------------
# Access Control
# -------------------------------------------
# Comma-separated list of email addresses allowed to login
# Only these emails can access the application
ALLOWED_EMAILS=your-email@gmail.com

# -------------------------------------------
# Reverse Proxy Configuration (Development Only)
# -------------------------------------------
# Set to "true" if using HTTPS reverse proxy in development
# This enables secure cookies which are required for HTTPS
# Not needed in production (NODE_ENV=production auto-enables this)
USE_SECURE_COOKIES=false

# -------------------------------------------
# Two-Factor Authentication (TOTP)
# -------------------------------------------
# 32-byte hex key for encrypting TOTP secrets at rest (AES-256-GCM)
# Generate with: openssl rand -hex 32
# Must be separate from NEXTAUTH_SECRET (key separation)
TOTP_MASTER_KEY=

# HMAC secret for signing 2FA nonces and trusted device cookies
# Must be separate from NEXTAUTH_SECRET (key separation)
# Generate with: openssl rand -base64 32
TOTP_HMAC_SECRET=

# -------------------------------------------
# Cloudflare D1 Worker Proxy (Runtime)
# -------------------------------------------
# URL of the deployed Cloudflare Worker D1 proxy
SURETY_WORKER_URL=https://surety-db-proxy.your-account.workers.dev

# Shared secret for authenticating with the Worker proxy
# Must match the WORKER_SHARED_SECRET configured in the Worker
# Generate with: openssl rand -base64 32
SURETY_WORKER_SECRET=

# Override target D1 database (for E2E test dev server)
# Values: production (default), api-e2e, ui-e2e, mcp-e2e
# SURETY_TARGET_DB=production

# -------------------------------------------
# Cloudflare D1 Management (drizzle-kit only)
# -------------------------------------------
# Only needed for schema push/migrate via drizzle-kit
# Not needed at runtime
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_DATABASE_ID=your-d1-database-id
# CLOUDFLARE_D1_TOKEN=your-api-token-with-d1-edit-permission
