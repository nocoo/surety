{
  "name": "surety",
  "version": "2.2.3",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:worker": "cd apps/worker && bun run dev",
    "build": "cd apps/web && bun run build",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit && cd apps/web && tsc --noEmit && cd ../cli && tsc --noEmit",
    "lint:typecheck:cached": "bun run scripts/run-g1a.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-remote.ts",
    "test:web": "vitest run apps/web/src/__tests__/",
    "test:worker": "vitest run apps/worker/__tests__/",
    "test:cli": "vitest run apps/cli/__tests__/",
    "test": "vitest run",
    "test:l2:http": "bun run scripts/run-l2-http.ts",
    "test:e2e:browser": "cd apps/web && bun run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:coverage:cached": "bun run scripts/run-l1.ts",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.30",
    "lucide-react": "1.24.0",
    "path-to-regexp": "^8.4.0",
    "radix-ui": "1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^17.0.0",
    "recharts": "3.9.2",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.9",
    "eslint": "10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.10",
    "undici": "^7.28.0",
    "ws": "^8.21.1",
    "wrangler": "4.110.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --cache --cache-location node_modules/.cache/eslint/"
    ]
  }
}
