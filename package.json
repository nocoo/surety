{
	"name": "surety",
	"version": "2.3.5",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "cd apps/web && bun run dev",
		"dev:worker": "cd apps/worker && bun run dev",
		"build": "cd apps/web && bun run build",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit && cd apps/web && tsc --noEmit && cd ../cli && tsc --noEmit && cd ../worker && tsc --noEmit",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run scripts/seed-remote.ts",
		"test:web": "vitest run apps/web/src/__tests__/",
		"test:worker": "vitest run apps/worker/__tests__/",
		"test:cli": "vitest run apps/cli/__tests__/",
		"test": "vitest run",
		"test:l2:http": "bun run scripts/run-l2-http.ts",
		"test:e2e:browser": "cd apps/web && bun run test:e2e",
		"test:coverage": "vitest run --coverage",
		"release": "bun run scripts/release.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@nocoo/basalt": "2.1.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "4.13.8",
		"lucide-react": "1.47.0",
		"path-to-regexp": "^8.4.0",
		"radix-ui": "1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-dropzone": "^20.1.2",
		"recharts": "3.10.1",
		"tailwind-merge": "3.7.0",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tailwindcss/postcss": "4.3.3",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.0.1",
		"drizzle-kit": "^0.31.9",
		"husky": "^9.1.7",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"overrides": {
		"esbuild": "^0.28.1",
		"nanoid": "3.3.18",
		"path-to-regexp": "^8.4.0",
		"postcss": "^8.5.18",
		"sharp": "0.35.4",
		"undici": "^7.29.0",
		"ws": "^8.21.3",
		"wrangler": "4.135.0"
	}
}
