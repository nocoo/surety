{
  "name": "surety",
  "version": "2.0.4",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:worker": "cd apps/worker && npx wrangler dev --port 7016",
    "build": "cd apps/web && bun run build",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit && cd apps/web && tsc --noEmit && cd ../cli && tsc --noEmit",
    "lint:typecheck:cached": "bun run scripts/run-g1a.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-remote.ts",
    "test:web": "vitest run apps/web/src/__tests__/",
    "test:worker": "vitest run apps/worker/__tests__/",
    "test:cli": "vitest run apps/cli/__tests__/",
    "test": "vitest run",
    "test:l2:http": "bun run scripts/run-l2-http.ts",
    "test:e2e:browser": "cd apps/web && bun run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:coverage:cached": "bun run scripts/run-l1.ts",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "lucide-react": "^0.577.0",
    "otpauth": "^9.5.0",
    "path-to-regexp": "^8.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "ws": "8.20.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^20.19.37",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "postcss": "^8.5.10",
    "ws": "^8.20.1",
    "wrangler": "4.84.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --cache --cache-location node_modules/.cache/eslint/"
    ]
  }
}
