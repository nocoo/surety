{
  "name": "surety",
  "version": "1.6.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:worker": "cd apps/worker && npx wrangler dev --port 7016",
    "dev:legacy": "cd apps/web_legacy && next dev --port 7012",
    "build": "cd apps/web && bun run build",
    "build:legacy": "cd apps/web_legacy && next build",
    "lint": "eslint --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit && cd apps/web && tsc --noEmit && cd ../cli && tsc --noEmit",
    "lint:typecheck:cached": "bun run scripts/run-g1a.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-remote.ts",
    "test:web": "bun test apps/web/src/__tests__/",
    "test:worker": "bun test apps/worker/__tests__/",
    "test:cli": "bun test apps/cli/__tests__/",
    "test:legacy": "cd apps/web_legacy && bun test src/__tests__/*.test.ts src/__tests__/db/*.test.ts",
    "test": "bun run test:web && bun run test:worker && bun run test:cli && bun run test:legacy",
    "test:coverage": "bun run scripts/check-coverage.ts",
    "test:coverage:cached": "bun run scripts/run-l1.ts",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:ui": "bun run scripts/run-e2e-ui.ts",
    "test:all": "bun run test:coverage && bun run test:e2e",
    "release": "bun run scripts/release.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.14",
    "lucide-react": "^0.577.0",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "otpauth": "^9.5.0",
    "path-to-regexp": "^8.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^20.19.37",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --cache --cache-location node_modules/.cache/eslint/"
    ]
  }
}
