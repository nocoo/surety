# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# claude session state
.claude/scheduled_tasks.lock

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# vite build output (Worker static assets)
apps/worker/static/assets/
apps/worker/static/index.html

# typescript
*.tsbuildinfo
next-env.d.ts

.next-e2e
.next-e2e-ui
**/.next-e2e
**/.next-e2e-ui

# playwright
test-results/
playwright-report/
e2e/test-results/
e2e/playwright-report/

# source logo files (large, in root only)
/logo-*.png

# wrangler local emulator state + temp files
**/.wrangler/
apps/worker/.l2-http-schema.sql
apps/worker/.l3-schema.sql
apps/web/test-results/
apps/web/playwright-report/

# benchmark run logs (data, not source)
autoresearch.jsonl
*.autoresearch.jsonl
