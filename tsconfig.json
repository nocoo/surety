{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@surety/db": ["./packages/db/src/index.ts"],
      "@surety/db/*": ["./packages/db/src/*"],
      "@surety/api": ["./packages/api/src/index.ts"],
      "@surety/api/*": ["./packages/api/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "apps/worker",
    "apps/web"
  ]
}
