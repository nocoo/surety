{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/web_legacy/src/*"],
      "@surety/db": ["./packages/db/src/index.ts"],
      "@surety/db/*": ["./packages/db/src/*"],
      "@surety/api": ["./packages/api/src/index.ts"],
      "@surety/api/*": ["./packages/api/src/*"],
      "@surety/mcp": ["./packages/mcp/src/index.ts"],
      "@surety/mcp/*": ["./packages/mcp/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "apps/web_legacy/.next/types/**/*.ts",
    "apps/web_legacy/.next/dev/types/**/*.ts",
    "apps/web_legacy/.next-e2e/dev/types/**/*.ts",
    "apps/web_legacy/.next-e2e/types/**/*.ts",
    "apps/web_legacy/.next-e2e-ui/types/**/*.ts",
    "apps/web_legacy/.next-e2e-ui/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "apps/worker",
    "apps/web"
  ]
}
